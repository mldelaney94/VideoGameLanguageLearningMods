msgstr ""
"{{CC}}​敏捷​：​$(story.Global_Skillcheck_Hard)​{{/CC}}​{{GM}}​在​他​完成​前​抢先​发起​攻击​。​{{/GM}}\n"
"{{CC}} min3jie2：$(story.Global_Skillcheck_Hard) {{/CC}} {{GM}} zai4 ta1 wan2cheng2 qian2 qiang3xian1 fa1qi3 gong1ji1。{{/GM}}"

msgid ""
"{{CC}}Quickness: $(story.Global_Skillcheck_Hard){{/CC}} {{GM}}Attack him "
"before he can finish.{{/GM}}"
msgstr ""
"{{CC}}​敏捷​：​$(story.Global_Skillcheck_Hard)​{{/CC}}​{{GM}}​在​他​完成​前​抢先​发起​攻击​。​{{/GM}}\n"
"{{CC}} min3jie2：$(story.Global_Skillcheck_Hard) {{/CC}} {{GM}} zai4 ta1 wan2cheng2 qian2 qiang3xian1 fa1qi3 gong1ji1。{{/GM}}"

msgid ""
"{{CC}}Quickness: $(story.Global_Skillcheck_Hard){{/CC}} {{GM}}Try to grab "
