msgstr ""
"冲击波​III\n"
"chong1ji1bo1 III"

msgid "Blasting Charges"
msgstr ""
"爆破​炸药\n"
"bao4po4 zha4yao4"

msgid "Bleeding: HP -1 per RND"
msgstr ""
"流血​：​每​回合​损失​1​点​生命​值\n"
"liu2xue4：mei3 hui2he2 sun3shi1 1 dian3 sheng1ming4 zhi2"

msgid "Bleeding: HP -2 per RND"
msgstr ""
"流血​：​每​回合​损失​2​点​生命​值\n"
"liu2xue4：mei3 hui2he2 sun3shi1 2 dian3 sheng1ming4 zhi2"

msgid "Bleeding: HP -3 per RND"
msgstr ""
"流血​：​每​回合​损失​3​点​生命​值\n"
"liu2xue4：mei3 hui2he2 sun3shi1 3 dian3 sheng1ming4 zhi2"

msgid "Bleeding: HP -6 per RND"
msgstr ""
"流血​：​每​回合​损失​6​点​生命​值\n"
"liu2xue4：mei3 hui2he2 sun3shi1 6 dian3 sheng1ming4 zhi2"

msgid "Blind eagle shaman and mistress of the spiked fist."
msgstr ""
"盲眼鹰​萨满​，​尖刺​指虎​的​女主人​。\n"
"mang2 yan3 ying1 sa4man3，jian1 ci1 zhi3 hu3 de5 nu:3zhu3ren2。"

msgid "Blinded"
msgstr ""
"致盲\n"
"zhi4 mang2"

msgid "Blindness"
msgstr ""
"失明​术\n"
"shi1ming2 shu4"

