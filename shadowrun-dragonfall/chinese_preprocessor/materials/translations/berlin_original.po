msgstr ""
"佣兵​打手\n"
"yong1bing1 da3shou5"

msgid "Mercenary Grenadier"
msgstr ""
"佣兵​掷弹​兵\n"
"yong1bing1 zhi4 dan4 bing1"

msgid "Mercenary Mage"
msgstr ""
"佣兵​法师\n"
"yong1bing1 fa3shi1"

